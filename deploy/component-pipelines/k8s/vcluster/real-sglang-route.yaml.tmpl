# A separate real-model route: the existing benchmark pool and gateway are
# untouched. All references remain inside the validated vCluster namespace.
apiVersion: inference.networking.k8s.io/v1
kind: InferencePool
metadata:
  name: real-sglang-split
spec:
  endpointPickerRef:
    name: real-qwen3-selector
    port: {number: 50051}
  selector:
    matchLabels: {app: real-sglang-split}
  targetPorts: [{number: 50051}]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: real-qwen3-selector
data:
  discovery.json: |
    {"pools":[{"namespace":"${VCLUSTER_NAMESPACE}","inference_pool_name":"real-sglang-split","model_name":"Qwen/Qwen3-0.6B","block_size":64}]}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: real-qwen3-selector
spec:
  replicas: 1
  selector:
    matchLabels: {app: real-qwen3-selector}
  template:
    metadata:
      labels: {app: real-qwen3-selector}
    spec:
      serviceAccountName: component-selector
      containers:
        - name: facade
          image: busybox:1.36
          command: ["${FACADE_STORE_PATH}/bin/dynamo-component-facade"]
          args: [--listen, "0.0.0.0:50051", selector, --discovery-config, /config/discovery.json]
          ports: [{name: grpc, containerPort: 50051}]
          readinessProbe:
            grpc: {port: 50051}
            periodSeconds: 5
          resources:
            requests: {cpu: "1", memory: 1Gi}
          volumeMounts:
            - {name: nix, mountPath: /nix/store, subPath: store, readOnly: true}
            - {name: config, mountPath: /config, readOnly: true}
      volumes:
        - name: nix
          nfs: {server: "${NIX_STORE_NFS_SERVER}", path: "${NIX_STORE_NFS_PATH}", readOnly: true}
        - name: config
          configMap: {name: real-qwen3-selector}
---
apiVersion: v1
kind: Service
metadata:
  name: real-qwen3-selector
spec:
  selector: {app: real-qwen3-selector}
  ports: [{name: grpc, port: 50051, targetPort: grpc}]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: real-qwen3-graph
data:
  aggregate.yaml: |
    api:
      openapi: ../specs/openai-chat.yaml
      operationId: createChatCompletion
    components:
      preprocessor:
        openapi: ../specs/preprocessor.yaml
        baseUrl: http://real-qwen3-preprocessor:50051
      selector:
        openapi: ../specs/selector.yaml
        baseUrl: http://real-qwen3-selector:50051
      workers:
        openapi: ../specs/chat-worker.yaml
        discovery: {group: aggregate}
    steps:
      - id: prepare
        call:
          component: preprocessor
          operationId: prepare
          timeoutMs: 10000
          input:
            item_id: "$.request.id"
            openai_request_json: "$.request.body"
            preserve_omitted_max_tokens: false
            lora_name: ""
            deadline_unix_ms: 0
            packed_tokens_only: true
          output:
            normalized_request: "$.response.normalized_openai_request_json"
            backend_request: "$.response.backend_request_json"
            selector_request: "$.response.selector_request_json"
            token_ids_le: "$.response.token_ids_le"
          batch: {maxSize: 32, lingerUs: 100}
      - id: select
        call:
          component: selector
          operationId: select
          timeoutMs: 2000
          input:
            item_id: "$.request.id"
            payload_json: "$.vars.selector_request"
            token_ids_le: "$.vars.token_ids_le"
            deadline_unix_ms: 0
          output:
            worker_endpoint: "$.response.payload_json.endpoint"
      - id: generate
        call:
          component: workers
          operationId: generate
          target: "$.vars.worker_endpoint"
          timeoutMs: 120000
          input:
            request_id: "$.request.id"
            backend_request_json: "$.vars.backend_request"
            normalized_openai_request_json: "$.vars.normalized_request"
            token_ids_le: "$.vars.token_ids_le"
            deadline_unix_ms: 0
          stream: {}
          respond: true
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: real-qwen3-agw-generic
data:
  config.yaml: |
    config:
      adminAddr: "off"
      statsAddr: "127.0.0.1:15020"
      readinessAddr: "0.0.0.0:15021"
      workerThreads: 8
      componentPipeline:
        mode: generic
        pipeline_file: "/etc/dynamo-pipeline/graphs/aggregate.yaml"
        grpc_descriptor_file: "/etc/dynamo-pipeline/components_descriptor.bin"
    binds:
    - port: 8080
      listeners:
      - name: real-qwen3
        protocol: HTTP
        routes:
        - name: chat
          backends:
          - host: real-sglang-split:50051
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: real-qwen3-agw-generic
spec:
  replicas: 1
  selector:
    matchLabels: {app: real-qwen3-agw-generic}
  template:
    metadata:
      labels: {app: real-qwen3-agw-generic}
    spec:
      containers:
        - name: gateway
          image: busybox:1.36
          command: ["${GATEWAY_BUNDLE_PATH}/bin/agentgateway"]
          args: [-f, /config/config.yaml]
          ports:
            - {name: http, containerPort: 8080}
            - {name: ready, containerPort: 15021}
          readinessProbe:
            tcpSocket: {port: 8080}
            periodSeconds: 5
          resources:
            requests: {cpu: "2", memory: 1Gi}
          volumeMounts:
            - {name: nix, mountPath: /nix/store, subPath: store, readOnly: true}
            - {name: config, mountPath: /config, readOnly: true}
            - {name: pipeline, mountPath: /etc/dynamo-pipeline, readOnly: true}
      volumes:
        - name: nix
          nfs: {server: "${NIX_STORE_NFS_SERVER}", path: "${NIX_STORE_NFS_PATH}", readOnly: true}
        - name: config
          configMap: {name: real-qwen3-agw-generic}
        - name: pipeline
          projected:
            sources:
              - configMap:
                  name: component-pipeline
                  items:
                    - {key: components_descriptor.bin, path: components_descriptor.bin}
                    - {key: openai-chat.yaml, path: specs/openai-chat.yaml}
                    - {key: preprocessor.yaml, path: specs/preprocessor.yaml}
                    - {key: selector.yaml, path: specs/selector.yaml}
                    - {key: chat-worker.yaml, path: specs/chat-worker.yaml}
              - configMap:
                  name: real-qwen3-graph
                  items:
                    - {key: aggregate.yaml, path: graphs/aggregate.yaml}
---
apiVersion: v1
kind: Service
metadata:
  name: real-qwen3-agw-generic
spec:
  selector: {app: real-qwen3-agw-generic}
  ports: [{name: http, port: 8080, targetPort: http}]
