+/// (`getFunctionPointer` + `if (ok())` for optional module callbacks). `RTLD_DEFAULT` is NULL
+/// on glibc, and it searches the global scope -- i.e. the Envoy binary that dlopened us.
+fn callout_with_options_fn() -> Option<CalloutWithOptionsFn> {
+  static RESOLVED: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
