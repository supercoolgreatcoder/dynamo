index 0000000..3ad4283
--- /dev/null
+++ b/crates/agentgateway/src/dynamo_components.rs
@@ -0,0 +1,273 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Thin agentgateway host for Dynamo component pipelines.
+//!
+//! This module owns HTTP body/SSE framing only. Prompt rendering, tokenization,
+//! selection, inference, detokenization, and OpenAI response policy stay in the
+//! Dynamo facade services and their canonical engines.
+
+use std::{collections::BTreeMap, convert::Infallible, sync::Arc};
+
+use dynamo_generic_pipeline::{Document, Pipeline, Prepared, Sink, referenced_specs};
+use dynamo_pipeline_grpc::GrpcTransport;
+use dynamo_static_pipeline::StaticAggregatePipeline;
+use futures_util::StreamExt;
+use http_body_util::BodyExt;
+use serde_json::Value;
+
+use crate::http::{Body, Request, Response};
+
+const CHAT_COMPLETIONS_PATH: &str = "/v1/chat/completions";
+
+#[derive(serde::Serialize, serde::Deserialize, Clone, Debug)]
+#[cfg_attr(feature = "schema", derive(crate::JsonSchema))]
+#[serde(tag = "mode", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ComponentPipelineConfig {
+	Static {
+		preprocessor_endpoint: String,
+		selector_endpoint: String,
+	},
+	Generic {
+		pipeline_file: std::path::PathBuf,
+		grpc_descriptor_file: std::path::PathBuf,
+	},
+}
+
+#[derive(Clone)]
+pub enum ComponentPipeline {
+	Static(StaticAggregatePipeline),
+	Generic {
+		prepared: Arc<Prepared>,
+		transport: Arc<GrpcTransport>,
+	},
+}
+
+impl std::fmt::Debug for ComponentPipeline {
+	fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+		formatter.write_str(match self {
+			Self::Static(_) => "ComponentPipeline::Static",
+			Self::Generic { .. } => "ComponentPipeline::Generic",
+		})
+	}
+}
+
+impl ComponentPipeline {
+	pub async fn load(config: &ComponentPipelineConfig) -> anyhow::Result<Self> {
+		match config {
+			ComponentPipelineConfig::Static {
+				preprocessor_endpoint,
+				selector_endpoint,
+			} => Ok(Self::Static(
+				StaticAggregatePipeline::connect(preprocessor_endpoint.clone(), selector_endpoint.clone())
+					.await?,
+			)),
+			ComponentPipelineConfig::Generic {
+				pipeline_file,
+				grpc_descriptor_file,
+			} => {
+				let text = std::fs::read_to_string(pipeline_file)?;
+				let pipeline = Pipeline::from_yaml(&text)
+					.map_err(|error| anyhow::anyhow!("parse {}: {error}", pipeline_file.display()))?;
+				let root = pipeline_file
+					.parent()
+					.ok_or_else(|| anyhow::anyhow!("pipeline path has no parent"))?;
+				let mut specs = BTreeMap::new();
+				for reference in referenced_specs(&pipeline) {
+					let path = root.join(&reference);
+					let spec = std::fs::read_to_string(&path)?;
+					specs.insert(
+						reference,
+						Document::from_yaml(&spec)
+							.map_err(|error| anyhow::anyhow!("parse {}: {error}", path.display()))?,
+					);
+				}
+				let prepared = Prepared::new(pipeline, &specs)
+					.map_err(|error| anyhow::anyhow!("pipeline validation: {error}"))?;
+				let prepared = Arc::new(prepared);
+				let descriptor = std::fs::read(grpc_descriptor_file)?;
+				let transport = GrpcTransport::new(&descriptor)
+					.map_err(|error| anyhow::anyhow!("descriptor: {error}"))?;
+				if let Ok(interval_secs) = std::env::var("DYN_GENERIC_STATS_INTERVAL_SECS") {
+					let interval_secs: u64 = interval_secs
+						.parse()
+						.map_err(|error| anyhow::anyhow!("DYN_GENERIC_STATS_INTERVAL_SECS: {error}"))?;
+					anyhow::ensure!(interval_secs > 0, "DYN_GENERIC_STATS_INTERVAL_SECS must be positive");
+					anyhow::ensure!(interval_secs <= 3600, "DYN_GENERIC_STATS_INTERVAL_SECS must be at most 3600");
+					let weak = Arc::downgrade(&prepared);
+					tokio::spawn(async move {
+						let mut timer = tokio::time::interval(std::time::Duration::from_secs(interval_secs));
+						timer.tick().await;
+						loop {
+							timer.tick().await;
+							let Some(prepared) = weak.upgrade() else { break };
+							tracing::debug!(target: "dynamo_generic_pipeline_stats",
+								requests = prepared.stats.requests(),
+								steps = ?prepared.stats.snapshot(),
+								"generic pipeline step statistics");
+						}
+					});
+				}
+				Ok(Self::Generic {
+					prepared,
+					transport: Arc::new(transport),
+				})
+			},
+		}
+	}
+
+	pub fn handles(&self, request: &Request) -> bool {
+		request.method() == http::Method::POST && request.uri().path() == CHAT_COMPLETIONS_PATH
+	}
+
+	pub async fn handle(&self, request: Request) -> Response {
+		let (_, body) = request.into_parts();
+		let body = match body.collect().await {
+			Ok(body) => body.to_bytes(),
+			Err(error) => return error_response(http::StatusCode::BAD_REQUEST, error.to_string()),
+		};
+		let parsed: Value = match serde_json::from_slice(&body) {
+			Ok(parsed) => parsed,
+			Err(error) => return error_response(http::StatusCode::BAD_REQUEST, error.to_string()),
+		};
+		if parsed.get("stream").and_then(Value::as_bool) != Some(true) {
+			return error_response(
+				http::StatusCode::NOT_IMPLEMENTED,
+				"component pipeline currently requires stream=true",
+			);
+		}
+
+		let request_id = uuid::Uuid::new_v4().to_string();
+		match self {
+			Self::Static(pipeline) => static_response(pipeline, request_id, body.to_vec()).await,
+			Self::Generic {
+				prepared,
+				transport,
+			} => generic_response(prepared.clone(), transport.clone(), request_id, parsed),
+		}
+	}
+}
+
+fn error_response(status: http::StatusCode, message: impl ToString) -> Response {
+	let body = serde_json::json!({"error": {"message": message.to_string()}}).to_string();
+	http::Response::builder()
+		.status(status)
+		.header(http::header::CONTENT_TYPE, "application/json")
+		.body(Body::from(body))
+		.expect("static response is valid")
+}
+
+fn sse_response(
+	stream: impl futures_core::Stream<Item = Result<bytes::Bytes, Infallible>> + Send + Sync + 'static,
+) -> Response {
+	http::Response::builder()
+		.status(http::StatusCode::OK)
+		.header(http::header::CONTENT_TYPE, "text/event-stream")
+		.header(http::header::CACHE_CONTROL, "no-cache")
+		.body(Body::from_stream(stream))
+		.expect("static response is valid")
+}
+
+async fn static_response(
+	pipeline: &StaticAggregatePipeline,
+	request_id: String,
+	body: Vec<u8>,
+) -> Response {
+	let mut stream = match pipeline.execute(request_id, body, 0).await {
+		Ok(stream) => stream,
+		Err(error) => return error_response(http::StatusCode::BAD_GATEWAY, error),
+	};
+	let (tx, rx) = tokio::sync::mpsc::channel(256);
+	tokio::spawn(async move {
+		while let Some(item) = stream.next().await {
+			match item {
+				Ok(item) if item.error.is_none() && !item.openai_chunk_json.is_empty() => {
+					if tx.send(Ok(frame(&item.openai_chunk_json))).await.is_err() {
+						return;
+					}
+				},
+				Ok(item) if item.error.is_some() => {
+					let _ = tx
+						.send(Ok(frame_error(item.error.expect("checked above").message)))
+						.await;
+					return;
+				},
+				Ok(_) => {},
+				Err(error) => {
+					let _ = tx.send(Ok(frame_error(error.message()))).await;
+					return;
+				},
+			}
+		}
+		let _ = tx
+			.send(Ok(bytes::Bytes::from_static(b"data: [DONE]\n\n")))
+			.await;
+	});
+	sse_response(tokio_stream::wrappers::ReceiverStream::new(rx))
+}
+
+struct ChannelSink {
+	tx: tokio::sync::mpsc::Sender<Value>,
+}
+
+#[async_trait::async_trait]
+impl Sink for ChannelSink {
+	async fn item(&self, value: Value) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+		self
+			.tx
+			.send(value)
+			.await
+			.map_err(|_| "client disconnected".into())
+	}
+}
+
+fn generic_response(
+	prepared: Arc<Prepared>,
+	transport: Arc<GrpcTransport>,
+	request_id: String,
+	body: Value,
+) -> Response {
+	let (tx, mut rx) = tokio::sync::mpsc::channel(256);
+	tokio::spawn(async move {
+		let sink = ChannelSink { tx: tx.clone() };
+		let request = serde_json::json!({"id": request_id, "body": body});
+		if let Err(error) = prepared.run_with_sink(&*transport, request, &sink).await {
+			let _ = tx
+				.send(serde_json::json!({"error": error.to_string()}))
+				.await;
+		}
+	});
+	let output = async_stream::stream! {
+	while let Some(item) = rx.recv().await {
+	if let Some(error) = item.get("error").and_then(Value::as_str) {
+	yield Ok::<_, Infallible>(frame_error(error));
+	return;
+	}
+	match serde_json::to_vec(&item) {
+	Ok(chunk) => yield Ok(frame(&chunk)),
+	Err(error) => {
+	yield Ok(frame_error(error));
+	return;
+	},
+	}
+	}
+	yield Ok(bytes::Bytes::from_static(b"data: [DONE]\n\n"));
+	};
+	sse_response(output)
+}
+
+fn frame(chunk: &[u8]) -> bytes::Bytes {
+	let mut output = Vec::with_capacity(chunk.len() + 8);
+	output.extend_from_slice(b"data: ");
+	output.extend_from_slice(chunk);
+	output.extend_from_slice(b"\n\n");
+	bytes::Bytes::from(output)
+}
+
+fn frame_error(error: impl ToString) -> bytes::Bytes {
+	frame(
+		serde_json::json!({"error": {"message": error.to_string()}})
+			.to_string()
+			.as_bytes(),
+	)
+}
