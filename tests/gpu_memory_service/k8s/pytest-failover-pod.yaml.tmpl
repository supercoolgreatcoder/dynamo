# Run the actual pytest shadow-failover e2e (test_shadow_failover.py) inside a single
# store-native busybox container on Kubernetes — the k8s analogue of running the test on
# one host in multiple processes. The test owns the failover choreography (GMSProcessManager
# pause/resume), so this exercises the SAME fast-failover path the single-host test does;
# the only difference is the container boundary.
#
# Two container-tooling fixes vs a naive store-native pod (both required, see README):
#   1) GNU sed + coreutils ahead of busybox on PATH — busybox `sed` lacks `-u`, which
#      managed_process uses to drain engine stdout; without it the engine's stdout pipe
#      fills and the engine deadlocks on write().
#   2) wrapper-`nvcc` + shadow `CUDA_HOME` — tvm-ffi's runtime sgl-kernel JIT probes the
#      host compiler via `$CUDA_HOME/bin/nvcc` with a reset env (NVCC_PREPEND_FLAGS is
#      lost), so `-ccbin g++` must be baked into an nvcc wrapper that CUDA_HOME points at.
apiVersion: v1
kind: Pod
metadata:
  name: bulwark-pytest-__ENGINE__
  labels: {app: bulwark-pytest-failover}
spec:
  restartPolicy: Never
  runtimeClassName: nvidia
  tolerations:
  - {effect: NoSchedule, key: nvidia.com/gpu, operator: Exists}
  volumes:
  - {name: rootfs, persistentVolumeClaim: {claimName: rootfs}}
  - {name: models, persistentVolumeClaim: {claimName: shared-model-cache}}
  - {name: dshm, emptyDir: {medium: Memory, sizeLimit: 32Gi}}
  - {name: tmp, emptyDir: {}}
  containers:
  - name: test
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args:
    - |
      ln -sf __LDCONFIG__ /sbin/ldconfig 2>/dev/null || true
      # wrapper nvcc (-ccbin) via shadow CUDA_HOME (fix #2) — see header.
      CUDA=__CUDA__; CCBIN=__CCW__
      WRAP=/tmp/cudawrap; rm -rf "$WRAP"; mkdir -p "$WRAP/bin"
      for e in "$CUDA"/*;     do n=$(basename "$e"); [ "$n" = bin ]  && continue; ln -s "$e" "$WRAP/$n";     done
      for e in "$CUDA"/bin/*; do n=$(basename "$e"); [ "$n" = nvcc ] && continue; ln -s "$e" "$WRAP/bin/$n"; done
      printf '#!/bin/sh\nexec %s/bin/nvcc -ccbin %s/bin/g++ "$@"\n' "$CUDA" "$CCBIN" > "$WRAP/bin/nvcc"
      chmod +x "$WRAP/bin/nvcc"
      cd /dsrc
      exec __ENGINE_VENV_PYTHON__ -m pytest \
        tests/gpu_memory_service/test_shadow_failover.py::test_gms_shadow_engine_failover___ENGINE__ \
        -c /dev/null -p no:cacheprovider -o addopts="" -p asyncio --timeout=900 -s -v
    env:
    - {name: HOME, value: /tmp}
    - {name: CUDA_VISIBLE_DEVICES, value: "0"}
    - {name: GMS_TEST_CUDA_DEVICE, value: "0"}
    - {name: LD_LIBRARY_PATH, value: "__OPENMPI_LIB__:/usr/lib/x86_64-linux-gnu:/run/opengl-driver/lib"}
    # fix #1 (GNU sed+coreutils first) + fix #2 (/tmp/cudawrap/bin ahead of real cuda/bin).
    - {name: PATH, value: "__PATH__"}
    - {name: PYTHONPATH, value: "__PYTHONPATH__"}
    - {name: CC, value: "__CCW__/bin/gcc"}
    - {name: CXX, value: "__CCW__/bin/g++"}
    - {name: CUDAHOSTCXX, value: "__CCW__/bin/g++"}
    - {name: CUDA_HOME, value: "/tmp/cudawrap"}
    - {name: CUDA_PATH, value: "/tmp/cudawrap"}
    - {name: NVCC_PREPEND_FLAGS, value: "-I__CUDA__/include -ccbin __CCW__/bin/g++"}
    - {name: CPATH, value: "__CUDA__/include"}
    - {name: LIBRARY_PATH, value: "__CUDA__/lib:__CUDA__/lib/stubs"}
    - {name: TRITON_LIBCUDA_PATH, value: "/usr/lib/x86_64-linux-gnu"}
    - {name: HF_HOME, value: "/models"}
    - {name: HF_HUB_OFFLINE, value: "1"}
    - {name: FAULT_TOLERANCE_MODEL_NAME, value: "__MODEL__"}
    - {name: GMS_SGLANG_SHARED_KV, value: "1"}
    - {name: GMS_KV_LEASES, value: "1"}
    - {name: GMS_SGLANG_KV_LEASES, value: "1"}
    - {name: GMS_KV_LEASE_SHM_DIR, value: "/dev/shm"}
    - {name: GMS_TEST_LEAK_THRESHOLD_MIB, value: "300000"}
    resources:
      limits: {cpu: "16", memory: 64Gi, nvidia.com/gpu: "1"}
    volumeMounts:
    - {mountPath: /nix/store, name: rootfs, subPath: store}
    - {mountPath: /dsrc, name: rootfs, subPath: dsrc}
    - {mountPath: /gms-pylib, name: rootfs, subPath: pylib}
    - {mountPath: /dev/shm, name: dshm}
    - {mountPath: /tmp, name: tmp}
    - {mountPath: /models, name: models}
