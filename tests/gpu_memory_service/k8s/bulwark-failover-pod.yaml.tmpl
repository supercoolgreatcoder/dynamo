# Single-pod Bulwark GMS shadow-failover — store-native (busybox + NFS Nix store).
#
# Kubernetes analogue of tests/gpu_memory_service/test_shadow_failover.py. Five
# containers in ONE pod share ONE GPU's memory through GMS, a /dev/shm KV-lease
# table, and a failover flock — the same mechanism the single-host e2e exercises:
#
#   gms-weights   GMS weights daemon      (gpu_memory_service.cli.server, tag=weights)
#   gms-kv-cache  GMS kv_cache daemon     (gpu_memory_service.cli.server, tag=kv_cache)
#   frontend      nats + etcd + dynamo.frontend (OpenAI HTTP ingress)
#   engine-0      primary engine          (ENGINE_ID=0, *_GMS_LOCK_BEFORE_INIT=1)
#   engine-1      shadow engine           (ENGINE_ID=1, DYN_GMS_FAILOVER_SHADOW_MODE=true)
#
# NO operator / Grove needed: this is a plain Pod. Failover is local — the engines
# self-coordinate via the shared flock (Bulwark runtime behavior); trigger it by
# killing engine-0 and confirm the frontend keeps serving via engine-1.
#
# GPU sharing uses native DRA (the same feature Bulwark uses): a single
# ResourceClaim (DeviceClass gpu.nvidia.com) is referenced by all four GPU
# containers, so they share the one allocated GPU. No NVIDIA_VISIBLE_DEVICES /
# CUDA_VISIBLE_DEVICES / UUID juggling — DRA exposes the same device to each as cuda:0.
#
# Placeholders (filled by run-failover-k8s.sh): __ENGINE__ __MODEL__ __VLLM_UTIL__
#   __ENGINE_VENV__ __RT_SP__ __GMS_SP__ __RING_SP__ __SRC_SP__ __SERVICES_BIN__ __LDCONFIG__
---
apiVersion: resource.k8s.io/v1
kind: ResourceClaimTemplate
metadata:
  name: bulwark-gpu-__ENGINE__
spec:
  spec:
    devices:
      requests:
      - name: gpu
        exactly:
          deviceClassName: gpu.nvidia.com
          allocationMode: ExactCount
          count: 1
---
apiVersion: v1
kind: Pod
metadata:
  name: bulwark-failover-__ENGINE__
  labels: {app: bulwark-failover, engine: __ENGINE__}
spec:
  restartPolicy: Never
  runtimeClassName: nvidia
  tolerations:
  - {effect: NoSchedule, key: nvidia.com/gpu, operator: Exists}
  # One DRA GPU claim, shared by all GPU containers below (GMS memory sharing).
  resourceClaims:
  - name: shared-gpu
    resourceClaimTemplateName: bulwark-gpu-__ENGINE__
  volumes:
  - {name: rootfs, persistentVolumeClaim: {claimName: rootfs}}      # Nix store -> /nix/store
  - {name: models, persistentVolumeClaim: {claimName: shared-model-cache}}
  - {name: gms-shared, emptyDir: {}}                                # UDS sockets + failover.lock
  - {name: dshm, emptyDir: {medium: Memory, sizeLimit: 16Gi}}       # /dev/shm KV leases
  - {name: tmp, emptyDir: {}}
  containers:
  # ---- GMS weights daemon -------------------------------------------------
  - name: gms-weights
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args: ["ln -sf __LDCONFIG__ /sbin/ldconfig 2>/dev/null || true; rm -f /run/gms/shared/gms_*_weights.sock; exec env GMS_SERVER_TAGS=weights GMS_SOCKET_DIR=/run/gms/shared __ENGINE_VENV__/bin/python -m gpu_memory_service.cli.server"]
    env: &gpuenv
    - {name: HOME, value: /tmp}
    - {name: LD_LIBRARY_PATH, value: "/usr/lib/x86_64-linux-gnu:/run/opengl-driver/lib"}
    - {name: TRITON_LIBCUDA_PATH, value: "/usr/lib/x86_64-linux-gnu"}   # where the nvidia runtime injects libcuda.so.1
    - {name: PYTHONPATH, value: "__RT_SP__:__GMS_SP__:__RING_SP__:__SRC_SP__:/gms-pylib"}
    resources:
      claims: [{name: shared-gpu}]
    volumeMounts: &gpumounts
    - {mountPath: /nix/store, name: rootfs, subPath: store}
    - {mountPath: /gms-pylib, name: rootfs, subPath: pylib}
    - {mountPath: /run/gms/shared, name: gms-shared}
    - {mountPath: /dev/shm, name: dshm}
    - {mountPath: /tmp, name: tmp}
    - {mountPath: /models, name: models}
  # ---- GMS kv_cache daemon ------------------------------------------------
  - name: gms-kv-cache
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args: ["ln -sf __LDCONFIG__ /sbin/ldconfig 2>/dev/null || true; rm -f /run/gms/shared/gms_*_kv_cache.sock; exec env GMS_SERVER_TAGS=kv_cache GMS_SOCKET_DIR=/run/gms/shared __ENGINE_VENV__/bin/python -m gpu_memory_service.cli.server"]
    env: *gpuenv
    resources:
      claims: [{name: shared-gpu}]
    volumeMounts: *gpumounts
  # ---- frontend (nats + etcd + dynamo.frontend) — no GPU ------------------
  - name: frontend
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args: ["__SERVICES_BIN__/dynamo-services & sleep 4; exec __ENGINE_VENV__/bin/python -m dynamo.frontend --http-port 8080"]
    env:
    - {name: HOME, value: /tmp}
    - {name: HF_HOME, value: "/models"}
    - {name: PYTHONPATH, value: "__RT_SP__:__SRC_SP__"}
    volumeMounts:
    - {mountPath: /nix/store, name: rootfs, subPath: store}
    - {mountPath: /tmp, name: tmp}
    - {mountPath: /models, name: models}
  # ---- engine-0 (primary) -------------------------------------------------
  - name: engine-0
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args: ["ln -sf __LDCONFIG__ /sbin/ldconfig 2>/dev/null || true; exec __ENGINE_VENV__/bin/python -m dynamo.__ENGINE__ --model __MODEL__ --load-format gms --gpu-memory-utilization __VLLM_UTIL__ __ENGINE_ARGS__"]
    env: &engineenv
    - {name: HOME, value: /tmp}
    - {name: HF_HOME, value: "/models"}
    - {name: LD_LIBRARY_PATH, value: "/usr/lib/x86_64-linux-gnu:/run/opengl-driver/lib"}
    - {name: TRITON_LIBCUDA_PATH, value: "/usr/lib/x86_64-linux-gnu"}   # where the nvidia runtime injects libcuda.so.1
    - {name: PYTHONPATH, value: "__RT_SP__:__GMS_SP__:__RING_SP__:__SRC_SP__:/gms-pylib"}
    - {name: GMS_SOCKET_DIR, value: "/run/gms/shared"}
    - {name: PATH, value: "__CCW__/bin:__CUDA__/bin:__ENGINE_VENV__/bin:/bin:/sbin:/usr/bin"}   # triton cc + nvcc + ninja
    - {name: CC, value: "__CCW__/bin/gcc"}
    - {name: CXX, value: "__CCW__/bin/g++"}
    - {name: CUDA_HOME, value: "__CUDA__"}                       # flashinfer JIT needs nvcc + CUDA_HOME
    - {name: NVCC_PREPEND_FLAGS, value: "-ccbin __CCW__/bin/g++"}
    - {name: CUDAHOSTCXX, value: "__CCW__/bin/g++"}
    - {name: LIBRARY_PATH, value: "__CUDA__/lib:__CUDA__/lib/stubs"}   # flashinfer links -lcudart/-lcuda (nix uses lib, not lib64)
    - {name: GMS_KV_LEASES, value: "1"}
    - {name: GMS_KV_LEASE_SHM_DIR, value: "/dev/shm"}
    - {name: GMS_VLLM_SHARED_KV, value: "1"}   # enables use_existing_shared_geometry(): shadow ATTACHES primary's KV pool instead of allocating its own
    - {name: ENGINE_ID, value: "0"}
    - {name: FAILOVER_LOCK_PATH, value: "/run/gms/shared/failover.lock"}
    - {name: DYN_GMS_FAILOVER_PRIMARY_ENGINE_ID, value: "0"}
    - {name: DYN_GMS_FAILOVER_SHADOW_MODE, value: "true"}
    - {name: DYN_VLLM_GMS_LOCK_BEFORE_INIT, value: "1"}
    - {name: DYN_SGLANG_GMS_LOCK_BEFORE_INIT, value: "1"}
    - {name: DYN_SYSTEM_ENABLED, value: "true"}
    - {name: DYN_SYSTEM_PORT, value: "9090"}
    resources:
      claims: [{name: shared-gpu}]
    volumeMounts: *gpumounts
  # ---- engine-1 (shadow) — waits for the primary to publish/register, then attaches the shared GMS pool
  - name: engine-1
    image: busybox:1.36
    command: ["/bin/sh","-c"]
    args: ["ln -sf __LDCONFIG__ /sbin/ldconfig 2>/dev/null || true; echo '[shadow] waiting for primary registration...'; until wget -qO- http://localhost:8080/v1/models 2>/dev/null | grep -q Qwen; do sleep 5; done; echo '[shadow] primary up; starting shadow'; exec __ENGINE_VENV__/bin/python -m dynamo.__ENGINE__ --model __MODEL__ --load-format gms --gpu-memory-utilization __VLLM_UTIL__ __ENGINE_ARGS__"]
    env:
    - {name: HOME, value: /tmp}
    - {name: HF_HOME, value: "/models"}
    - {name: LD_LIBRARY_PATH, value: "/usr/lib/x86_64-linux-gnu:/run/opengl-driver/lib"}
    - {name: TRITON_LIBCUDA_PATH, value: "/usr/lib/x86_64-linux-gnu"}   # where the nvidia runtime injects libcuda.so.1
    - {name: PYTHONPATH, value: "__RT_SP__:__GMS_SP__:__RING_SP__:__SRC_SP__:/gms-pylib"}
    - {name: GMS_SOCKET_DIR, value: "/run/gms/shared"}
    - {name: PATH, value: "__CCW__/bin:__CUDA__/bin:__ENGINE_VENV__/bin:/bin:/sbin:/usr/bin"}   # triton cc + nvcc + ninja
    - {name: CC, value: "__CCW__/bin/gcc"}
    - {name: CXX, value: "__CCW__/bin/g++"}
    - {name: CUDA_HOME, value: "__CUDA__"}                       # flashinfer JIT needs nvcc + CUDA_HOME
    - {name: NVCC_PREPEND_FLAGS, value: "-ccbin __CCW__/bin/g++"}
    - {name: CUDAHOSTCXX, value: "__CCW__/bin/g++"}
    - {name: LIBRARY_PATH, value: "__CUDA__/lib:__CUDA__/lib/stubs"}   # flashinfer links -lcudart/-lcuda (nix uses lib, not lib64)
    - {name: GMS_KV_LEASES, value: "1"}
    - {name: GMS_KV_LEASE_SHM_DIR, value: "/dev/shm"}
    - {name: GMS_VLLM_SHARED_KV, value: "1"}   # enables use_existing_shared_geometry(): shadow ATTACHES primary's KV pool instead of allocating its own
    - {name: ENGINE_ID, value: "1"}
    - {name: FAILOVER_LOCK_PATH, value: "/run/gms/shared/failover.lock"}
    - {name: DYN_GMS_FAILOVER_PRIMARY_ENGINE_ID, value: "0"}
    - {name: DYN_GMS_FAILOVER_SHADOW_MODE, value: "true"}
    - {name: DYN_VLLM_GMS_LOCK_BEFORE_INIT, value: "0"}
    - {name: DYN_SGLANG_GMS_LOCK_BEFORE_INIT, value: "0"}
    - {name: DYN_SYSTEM_ENABLED, value: "true"}
    - {name: DYN_SYSTEM_PORT, value: "9091"}
    resources:
      claims: [{name: shared-gpu}]
    volumeMounts: *gpumounts
